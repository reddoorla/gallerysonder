{
	// Kit 3 writes its generated config into node_modules as `$app/tsconfig`
	// (kit 2: ./.svelte-kit/tsconfig.json) and no longer supplies `include`.
	"extends": "$app/tsconfig",
	"include": ["src", "tests", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"allowImportingTsExtensions": true,
		"plugins": [
			{
				"name": "typescript-svelte-plugin"
			}
		]
	}
	// Path aliases are handled by `alias` in sveltekit.config.js (deprecated in
	// kit 3 in favour of package.json subpath imports).
}
