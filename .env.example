# Copy to `.env` and fill in. `.env` is gitignored; this example is committed.

# Skip the cookie-consent modal locally. When true, no consent UI shows and —
# because analytics are consent-gated — no GTM/FB Pixel loads. Leave unset (or
# false) in production so the modal appears and tracking is opt-in.
VITE_DISABLE_COOKIE_CONSENT = true

# Which Prismic repository (environment) the whole site reads from. Unset means
# the `repositoryName` in slicemachine.config.json — i.e. production content.
# Set this only to point a preview/staging deploy at a different Prismic
# environment; setting it wrong silently serves another repo's content.
# VITE_PRISMIC_ENVIRONMENT = gallerysonder-staging

# Google Maps Embed API key for the ContentWidthMedia "embed" map variation.
# This key is necessarily public (it ships in the iframe URL), so it MUST be
# locked down in the GCP console with HTTP-referrer + "Maps Embed API" restrictions.
# Also set this in the Netlify site env vars, or the embedded map renders blank.
VITE_GOOGLE_MAPS_EMBED_KEY = your-maps-embed-key

# Canonical origin used to build absolute URLs in /sitemap.xml. Prerendering
# can't read the real host, so set this to the production domain (no trailing
# slash). Use the APEX (no www) to match the host — www 301-redirects to apex,
# so canonical/og pointing at www costs a redirect. Defaults to
# https://gallerysonder.com if unset.
VITE_SITE_URL = https://gallerysonder.com

# Cloudflare Turnstile public sitekey for the bot challenge on every form
# (contact, inquiry, newsletter, RSVP). Public by design — it ships to the
# browser — so it is safe in Netlify's env vars; the SECRET key lives only in the
# central maintenance dashboard, which does the verifying.
# LEAVING THIS UNSET IS SILENT: TurnstileWidget renders nothing without it and
# submissions still succeed (central verify is fail-open), so a fresh clone ships
# every form with no bot challenge and nothing in CI catches it.
PUBLIC_TURNSTILE_SITE_KEY = your-turnstile-sitekey

# Fleet forms: forward submissions to the central dashboard ingest.
# Set BOTH vars in this site's Netlify env. Do NOT commit the real FORMS_INGEST_URL
# value — Netlify's secrets scanner fails the build if the live value is in the repo.
# This site's slug: sonder
FORMS_INGEST_URL=https://reddoor-maintenance.netlify.app/api/forms/<slug>
FORMS_INGEST_TOKEN=replace-with-the-shared-forms-ingest-token
