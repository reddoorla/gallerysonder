{
	"name": "gallerysonder",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"vite:dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . --plugin prettier-plugin-svelte . && eslint .",
		"format": "prettier --write . --plugin prettier-plugin-svelte .",
		"test:smoke": "playwright install chromium && playwright test",
		"prismic:gen": "prismic gen types && prismic gen slice-index"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.3",
		"@playwright/test": "^1.60.0",
		"@reddoorla/maintenance": "^0.97.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^25.9.3",
		"eslint": "^10.4.0",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^4.0.0",
		"prismic": "^1.22.0",
		"sharp": "^0.35.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.0",
		"typescript-svelte-plugin": "^0.3.36",
		"vite": "^8.2.0"
	},
	"type": "module",
	"dependencies": {
		"@lucide/svelte": "^1.20.0",
		"@prismicio/client": "^7.3.1",
		"@prismicio/svelte": "^2.0.0",
		"@zerodevx/svelte-img": "^2.1.2",
		"flatpickr": "^4.6.13",
		"svelte-gestures": "^5.2.2"
	},
	"packageManager": "pnpm@12.5.1"
}
